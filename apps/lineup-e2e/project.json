{
  "name": "lineup-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/lineup-e2e/src",
  "implicitDependencies": [
    "lineup"
  ],
  "// targets": "to see all targets run: nx show project lineup-e2e --web",
  "targets": {
    "serve": {
      "executor": "@nrwl/angular:webpack-server",
      "options": {
        "port": 4200
      }
    },
    "e2e": {
      "executor": "@nx/playwright:e2e",
      "outputs": [
        "{workspaceRoot}/dist/apps/lineup-e2e"
      ],
      "options": {
        "playwrightConfig": "apps/lineup-e2e/playwright.config.ts"
      }
    }
  }
}
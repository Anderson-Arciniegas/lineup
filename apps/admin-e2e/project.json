{
  "name": "admin-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin-e2e/src",
  "implicitDependencies": ["admin"],
  "// targets": "to see all targets run: nx show project admin-e2e --web",
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "dependsOn": ["admin:build"],
      "outputs": ["{workspaceRoot}/dist/apps/admin-e2e"],
      "options": {
        "config": "apps/admin-e2e/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs"
      ],
      "options": {
        "lintFilePatterns": ["apps/admin-e2e/**/*.ts", "apps/admin-e2e/**/*.js"]
      }
    }
  }
}
